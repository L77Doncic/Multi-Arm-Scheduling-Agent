# Multi-Arm Scheduling Agent - Environment Variables Example
# Copy this file to .env and fill in your API keys
# .env is gitignored and will NOT be committed

# LLM API Key (ModelScope OpenAI-compatible API)
# Get your key from https://www.modelscope.cn/
OPENAI_API_KEY=your-modelscope-api-key-here

# Alternative: OpenAI API
# OPENAI_API_KEY=sk-your-openai-key-here

# Alternative: Anthropic API
# ANTHROPIC_API_KEY=your-anthropic-key-here
